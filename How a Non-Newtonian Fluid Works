@charset "utf-8";

:root { --bg: #f7f6f2; --ink: #1a1a24; --muted: #5b5e6b; --card: #ffffff; --water: #1f7ae0; --thick: #e0820b; --thin: #8a4fd1; --accent: #e0820b; --line: #e3e1da; }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--bg); color: var(--ink); font-family: Inter, system-ui, sans-serif; line-height: 1.6; }

h1, h2, h3 { font-family: Fraunces, Georgia, serif; line-height: 1.15; margin: 0px 0px 0.5em; }

.wrap { max-width: 900px; margin: 0px auto; padding: 0px 20px; }

header { background: radial-gradient(circle at 80% 20%, rgb(246, 198, 107) 0px, rgb(224, 130, 11) 35%, rgb(107, 47, 10) 100%); color: rgb(255, 255, 255); padding: 64px 0px 72px; overflow: hidden; }

header h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); }

header p { max-width: 580px; font-size: 1.1rem; opacity: 0.95; }

.tag { display: inline-block; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.8; margin-bottom: 12px; }

section { padding: 48px 0px; border-bottom: 1px solid var(--line); }

section h2 { font-size: clamp(1.6rem, 4vw, 2.2rem); }

.lead { font-size: 1.1rem; color: var(--muted); max-width: 680px; }

.card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 24px; margin: 20px 0px; }

.grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }

.ex { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 18px; }

.ex .em { font-size: 1.8rem; }

.ex h3 { font-size: 1.15rem; margin: 6px 0px 4px; }

.ex p { margin: 0px; color: var(--muted); font-size: 0.95rem; }

.chip { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 600; margin-bottom: 6px; }

.c-thick { background: rgb(253, 235, 214); color: rgb(153, 93, 0); }

.c-thin { background: rgb(239, 228, 251); color: rgb(106, 51, 170); }

.c-time { background: rgb(223, 244, 242); color: rgb(7, 122, 115); }

.c-yield { background: rgb(227, 237, 251); color: rgb(29, 91, 176); }

.tank { position: relative; height: 260px; border-radius: 14px; overflow: hidden; background: linear-gradient(rgb(251, 250, 247) 0px, rgb(251, 250, 247) 38%, rgb(243, 230, 201) 38%); border: 1px solid var(--line); cursor: pointer; user-select: none; touch-action: manipulation; }

.surface { position: absolute; left: 0px; right: 0px; top: 38%; height: 3px; background: rgb(217, 199, 156); }

#ball { position: absolute; left: 50%; width: 46px; height: 46px; margin-left: -23px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, rgb(138, 160, 184), rgb(47, 68, 89)); box-shadow: rgba(0, 0, 0, 0.25) 0px 4px 10px; }

#msg { position: absolute; left: 0px; right: 0px; bottom: 12px; text-align: center; font-weight: 600; color: rgb(107, 74, 18); }

.controls { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 14px; }

button { font-style: inherit; font-variant: inherit; font-stretch: inherit; font-size: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-weight: 600; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 10px; padding: 10px 16px; cursor: pointer; background: var(--ink); color: rgb(255, 255, 255); }

button.alt { background: rgb(255, 255, 255); color: var(--ink); border: 1px solid var(--line); }

.readout { font-variant-numeric: tabular-nums; font-weight: 600; }

canvas { width: 100%; height: auto; display: block; background: rgb(255, 255, 255); border-radius: 12px; border: 1px solid var(--line); }

table { width: 100%; border-collapse: collapse; font-size: 0.95rem; background: rgb(255, 255, 255); border-radius: 12px; overflow: hidden; }

th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }

th { background: rgb(239, 237, 230); font-weight: 600; }

ol.recipe { padding-left: 1.2em; }

ol.recipe li { margin: 6px 0px; }

.qr { display: flex; gap: 28px; align-items: center; flex-wrap: wrap; }

#qrcode { background: rgb(255, 255, 255); padding: 14px; border-radius: 14px; border: 1px solid var(--line); width: max-content; }

#qrcode img, #qrcode canvas { display: block; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.note { font-size: 0.85rem; color: var(--muted); }

footer { padding: 32px 0px 48px; color: var(--muted); font-size: 0.9rem; }
